#!/bin/zsh
# 제어 대상 큐(전역 규약 §18, ~/.claude/tools/vmq/README.md, 규칙 · 차례 파일 · 배정은 lib/vmq.zsh). 대상을 다루기 전에 차례를 받고,
# 끝나면 놓는다. 차례가 없으면 그 대상을 다루는 프로젝트 도구(예: poieve 의 tools/vm.sh · tools/vm-ui.sh)가 거절한다.
# 사용:
#   vmq acquire [-w 초] [-l 설명] <묶음>…   차례를 받는다. 묶음마다 후보 하나를 받는다. 묶음은 VM 이름, 쉼표로 적은 후보
#                                                      (PoieveServer,PoieveServer2), 역할(@server · @client) 중 하나다. 후보 중 먼저 비는
#                                                      것을 받는다. 후보는 + 로 이은 VM 여럿일 수 있고(PoieveServer2+PoieveClient2), 그 VM 이
#                                                      모두 빌 때 함께 받는다. @server+@client 는 같은 Mac 의 서버 · 클라이언트 짝들이다. 다른 소유자가 잡고 있으면 기다린다(기본 90초). 잡으면 종료 코드 0 이고
#                                                      받은 VM 을 묶음 순서로 찍는다. 기다리다 시간이 다 되면 75 이고 차례는 남는다(같은
#                                                      명령을 다시 실행해 이어서 기다린다). -w 는 이 명령 전체의 기한이다(끝난 사슬의 차례가
#                                                      없어지기를 기다리는 시간과 잡기를 기다리는 시간을 합친다, 0 이면 끝없이). 기다리는 중에
#                                                      다른 묶음으로 다시 실행하면 같은 순번으로 요청을 바꾼다
#   vmq mine                             내가 잡은 VM 을 묶음 순서로 한 줄에 찍는다. 잡지 않았으면 종료 코드 1
#   vmq ticket                           내 차례의 키(<10자리 일련번호>-<소유자>, 잡았든 기다리든)를 한 줄로 찍는다. 없으면 종료 코드 1
#   vmq release [<vm>…]                  내 차례를 지운다. VM 을 주면 그 VM 만 놓는다
#   vmq status [<vm>…]                   VM 마다 잡은 소유자와 기다리는 소유자
#   vmq status --json [<vm>…]            같은 판정을 요청(차례) 단위 JSON 한 개로 찍는다. 형식은 README.md 「status --json」
#   vmq ended <vm>                       내 그 VM 차례가 마지막에 끝난 사건(놓음 · 만료 · 강제로놓음) · 시각 · 그 뒤 잡은 다른 소유자(없으면 -)
#   vmq run [-l 설명] <묶음>… -- <명령…>  차례를 잡을 때까지 기다린 뒤 명령을 실행하고, 이 명령이 받은 차례면 놓는다.
#                                                      TERM · INT · HUP 으로 끝나도 놓는다(명령이 돌던 중이면 그 명령이 끝난 뒤). KILL 은 LEASE 로 만료된다.
#                                                      명령에는 받은 VM 이 환경 변수 VM_QUEUE_GRANTED(공백으로 나눈 목록)로 간다
#   vmq force-release <vm>              그 VM 을 잡은 차례를 지운다. 사용자가 지시할 때만 쓴다
#   vmq list                            대상 목록(이름 · Mac · 역할)
#   vmq peek-check '<명령 한 줄>'        차례 없이 실행해도 되는 읽기인지 판별한다(종료 코드 0 · 1)
# 소유자는 VM_QUEUE_OWNER, 없으면 CLAUDE_CODE_SESSION_ID. 설명은 -l 또는 VM_QUEUE_LABEL.
# 차례 고정: VM_QUEUE_TICKET=<키>(vmq ticket 이 찍은 값)를 주면 mine · release(와 lib/vmq.zsh 의 vmq_require · vmq_keepalive · vmq_chain_of ·
# vmq_chain_mark)는 그 키가 내 지금 차례일 때만 동작하고, 아니면 아무것도 하지 않고 stderr 에 고정한 키 · 지금 키를 쓰고 종료 코드 1.
# 다른 명령은 이 값을 보지 않는다(run 은 지운 뒤 명령을 실행한다).
# 종료 코드: 0 성공, 1 거절 · 오류, 2 사용법, 75 기다리는 중.
set -uo pipefail
source "${0:A:h:h}/lib/vmq.zsh"
cmd=${1:-status}; (( $# )) && shift

# 이 스크립트의 경로. 함수 안의 $0 은 함수 이름이라(zsh FUNCTION_ARGZERO) 여기서 받아 둔다. 전에는 usage 가 함수 안의 $0 을 써
# 사용법 대신 「sed: …/usage: No such file or directory」 를 냈다
self=${0:A}
# 사용법은 이 파일의 머리 주석(둘째 줄부터 # 이 아닌 첫 줄 앞까지)이다
usage() { sed -n '2,/^[^#]/{/^#/p;}' "$self"; exit 2 }

# VM_QUEUE_TICKET(고정할 차례 키)은 mine · release 만 본다(lib/vmq.zsh 의 vmq_sync · vmq_ticket_ok). 나머지 명령은 지운다: acquire · run 의
# register · hold 가 부르는 vmq_sync 가 그 값으로 거절하지 않게, run 은 자기 차례를 놓는 run_release(vmq release)가 바깥에서 물려받은 값으로
# 거절되지 않고 명령에도 물려지지 않게, ticket 은 고정할 키를 새로 읽을 때 앞의 값과 상관없이 읽게.
[[ $cmd == (mine|release) ]] || unset VM_QUEUE_TICKET

# 옵션: -w 초 · -l 설명. 나머지는 reply 에 남는다.
wait_s=90 label=${VM_QUEUE_LABEL:-}
parse() {
  reply=()
  while (( $# )); do
    case $1 in
    -w) wait_s=${2:?초}; shift 2 ;;
    -l) label=${2:?설명}; shift 2 ;;
    --) reply+=("$@"); return ;;
    *) reply+=("$1"); shift ;;
    esac
  done
}

# 묶음들을 풀어 groups 에 둔다: expand_groups <묶음>…
expand_groups() {
  local g e
  groups=()
  for g in "$@"; do e=$(vmq_expand $g) || return 1; groups+=($e); done
}

# JSON 문자열 하나: json_str <값> → REPLY. 역슬래시 · 따옴표 · 줄바꿈 · 탭 · CR 을 이스케이프하고 남은 제어 문자는 지운다
json_str() {
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\t'/\\t}; s=${s//$'\r'/\\r}; s=${s//[[:cntrl:]]/}
  REPLY="\"$s\""
}
# JSON 문자열 배열: json_arr <값>… → REPLY
json_arr() { local x out=(); for x in "$@"; do json_str "$x"; out+=($REPLY); done; REPLY="[${(j:,:)out}]" }
# 빈 값은 null: json_opt <값> → REPLY
json_opt() { [[ -n $1 ]] && json_str "$1" || REPLY=null }

# vmq status --json 의 본문(잠금 안에서 vmq_purge · vmq_scan · vmq_plan 을 마친 뒤). 대상은 $vms, 이 세션의 소유자는 $me.
# 대상마다 한 개와 차례(요청)마다 한 개를 낸다. 차례는 $vms 의 대상에 파일이 있는 것만 낸다. 만료 판정은 lib/vmq.zsh 의 vmq_key_expiry(차례 단위)다.
status_json() {
  local vm k f hk busy o waiting tv targets=() requests=() fields
  for vm in $vms; do
    hk=$(vmq_holder $vm); busy=${Q_busy[$vm]:-}
    vmq_tickets $vm; waiting=()
    for f in $reply; do [[ ${f:t} == $hk ]] || waiting+=(${f:t}); done
    fields=()
    json_str "$vm"; fields+=("\"name\":$REPLY")
    json_str "${VMQ_HOST[$vm]:-}"; fields+=("\"host\":$REPLY")
    json_arr ${=VMQ_ROLES[$vm]:-}; fields+=("\"roles\":$REPLY")
    json_opt "$hk"; fields+=("\"holder\":$REPLY")
    # 배정됨: 기다리던 차례가 다음 확인에서 잡을 대상. 맡아 둠: VMQ_STARVE 가 지난 차례가 맡아 둔 대상(vmq_plan 의 「~」)
    [[ -n $busy && $busy != "~"* && $busy != $hk ]] && json_str "$busy" || REPLY=null; fields+=("\"assigned\":$REPLY")
    [[ $busy == "~"* ]] && json_str "${busy#\~}" || REPLY=null; fields+=("\"reserved\":$REPLY")
    json_arr $waiting; fields+=("\"waiting\":$REPLY")
    targets+=("{${(j:,:)fields}}")
  done
  for k in ${(ok)Q_vms}; do
    tv=(${=Q_vms[$k]}); tv=(${tv:*vms}); (( ${#tv} )) || continue
    f=${Q_file[$k]}; o=$(vmq_key_owner $k); vmq_key_expiry $k ${=Q_vms[$k]}
    fields=()
    json_str "$k"; fields+=("\"key\":$REPLY" "\"seq\":$(( 10#${k%%-*} ))")
    json_str "$o"; fields+=("\"owner\":$REPLY")
    [[ $o == $me ]] && fields+=("\"isMine\":true") || fields+=("\"isMine\":false")
    json_str "$(vmq_field $f label)"; fields+=("\"label\":$REPLY")
    json_arr ${=Q_need[$k]}; fields+=("\"need\":$REPLY")
    json_arr ${=Q_vms[$k]}; fields+=("\"targets\":$REPLY")
    json_arr ${=Q_held[$k]}; fields+=("\"held\":$REPLY")
    [[ -z ${Q_held[$k]} ]] && json_arr ${=Q_alloc[$k]:-} || json_arr; fields+=("\"assigned\":$REPLY")
    fields+=("\"created\":$(( $(vmq_field $f created) + 0 ))" "\"active\":$(( $(vmq_field $f active) + 0 ))")
    json_arr ${=$(vmq_field $f procs)}; fields+=("\"procs\":$REPLY")
    json_arr ${=Q_exp[3]}; fields+=("\"alive\":$REPLY")
    fields+=("\"expiry\":{\"basis\":\"${Q_exp[1]}\",\"seconds\":${Q_exp[2]},\"since\":${Q_exp[4]}}")
    requests+=("{${(j:,:)fields}}")
  done
  json_opt "${me:#-}"
  print -r -- "{\"version\":1,\"now\":$EPOCHSECONDS,\"lease\":$VMQ_LEASE,\"holdMax\":$VMQ_HOLD_MAX,\"starve\":$VMQ_STARVE,\"owner\":$REPLY,\"targets\":[${(j:,:)targets}],\"requests\":[${(j:,:)requests}]}"
}

# 잡은 VM 으로 묶음들을 채울 수 있는가: covers <잡은 VM 목록> <묶음>…. 후보의 VM(+ 로 이은 것)이 모두 잡은 것에 있어야 한다.
covers() {
  local held=$1 g c vm used=() hit ok; shift
  for g in "$@"; do
    hit=
    for c in ${(s:,:)g}; do
      ok=1
      for vm in ${(s:+:)c}; do vmq_has "$held" $vm && (( ! ${used[(Ie)$vm]} )) || { ok=0; break }; done
      (( ok )) && { hit=$c; break }
    done
    [[ -n $hit ]] || return 1
    used+=(${(s:+:)hit})
  done
}

# 차례를 만들거나 바꾼다: register <소유자> <묶음>… → 새로 만들었으면 0, 이미 있었으면 3, 거절이면 1
# 잡은 뒤에는 바꾸지 않는다: 잡은 채 더 받으면 VM 마다의 순서가 어긋나 교착이 생길 수 있다. 기다리는 동안에는 같은 일련번호로 바꾼다.
# 잡은 차례가 끝난 사슬이 쥔 차례(lib/vmq.zsh 의 vmq_chain_ended)면 4: 그 사슬의 뒷정리가 아직 그 차례로 VM 을 끄고 되돌리는 중일 수 있어
# 같은 소유자에게도 넘기지 않는다. 부른 쪽(register_wait)은 그 차례가 없어질 때까지 기다린 뒤 새로 등록한다(poieve tracker bug_1792779968019_9ycb6f).
# 4 를 돌려줄 때는 그 차례 파일의 시각(마지막 활동)을 새로 적지 않는다. 그 판정은 이 함수가 부르는 vmq_sync 가 같은 vmq_chain_ended 로 한다.
# 뒷정리가 놓지 않은 차례는 마지막 활동에서 VMQ_LEASE 초 뒤 vmq_purge 가 지우고, 이 함수는 그 뒤 새 일련번호로 등록한다.
# 전에는 4 일 때도 시각을 새로 적어, 2초마다 다시 부르는 register_wait 가 그 차례를 만료되지 않게 했다. 차례에 적힌 프로세스 네 개가
# 모두 끝났는데 같은 소유자의 두 번째 acquire 가 「마지막 활동 0초 전」 을 유지했고, 뒤에서 기다리던 다른 소유자가 받지 못했다(2026-11-11 08:55Z, 일련번호 2775).
register() {
  local owner=$1 vm k f seq rc=3 c all=()
  shift
  local need="$*"
  vmq_all_members "$@"; all=($reply)
  vmq_lock || return 1
  {
    # acquire · run 은 VM_QUEUE_TICKET 을 지웠으므로 vmq_sync 는 거절하지 않는다
    vmq_sync $owner
    k=$REPLY
    # 이 return 에도 always 의 vmq_unlock 은 실행된다
    vmq_chain_ended "$k" && return 4
    if [[ -n $k && -n ${Q_held[$k]} ]]; then
      if ! covers "${Q_held[$k]}" "$@"; then
        print -u2 "제어 대상 큐: 이 소유자는 이미 ${Q_held[$k]} 를 잡았다. $need 가 필요하면 vmq release 한 뒤 함께 acquire 한다"
        rc=1
      fi
    elif [[ -n $k ]]; then
      if [[ ${Q_need[$k]} != $need ]]; then
        c=$(vmq_field ${Q_file[$k]} created)
        [[ -n $label ]] || label=$(vmq_field ${Q_file[$k]} label)
        for vm in ${(ok)VMQ_HOST}; do
          f="$VMQ_DIR/$vm/$k"
          if (( ${all[(Ie)$vm]} )); then mkdir -p "$VMQ_DIR/$vm"; vmq_write $f $owner "$label" $c "$need"; else rm -f -- $f; fi
        done
        vmq_log "바꿈 $owner $need${label:+ ($label)} (순번 ${k%%-*} 그대로)"
      fi
    else
      seq=$(( $(cat "$VMQ_DIR/.seq" 2>/dev/null || print 0) + 1 ))
      print $seq > "$VMQ_DIR/.seq"
      for vm in $all; do
        mkdir -p "$VMQ_DIR/$vm"
        vmq_write "$VMQ_DIR/$vm/${(l:10::0:)seq}-$owner" $owner "$label" $EPOCHSECONDS "$need"
      done
      vmq_log "등록 $owner $need${label:+ ($label)}"
      rc=0
    fi
  } always { vmq_unlock }
  return $rc
}

# register 가 4(끝난 사슬이 쥔 차례가 아직 남아 있음)이면 그 차례가 없어질 때까지 2초마다 register 를 다시 부른다:
# register_wait <소유자> <기한(epoch 초, 0 이면 기한 없음)> <묶음>…
# 기한은 acquire 가 시작할 때 한 번 정해 이 함수와 hold 가 함께 쓴다. 전에는 두 함수가 -w 초를 따로 세어, acquire -w N 이 최대 약 2N 초 기다렸다.
# 그 차례는 뒷정리가 놓거나(vmq release), 놓지 않으면 마지막 활동에서 VMQ_LEASE 초 뒤 만료되어 없어진다. 기다리는 동안 register 는 그 차례의
# 시각을 새로 적지 않는다. 그 차례에 적힌 프로세스(procs)가 살아 있고 마지막 제어 명령 · 갱신(active)에서 VMQ_HOLD_MAX 초가 지나지 않은 동안은
# 차례표를 읽는 쪽(vmq_purge)이 시각을 새로 적어 만료되지 않는다.
# 돌려주는 값은 register 와 같고, 기한 안에 없어지지 않으면 75.
register_wait() {
  local owner=$1 deadline=$2 rc told=0
  shift 2
  while true; do
    register $owner "$@"; rc=$?
    (( rc == 4 )) || return $rc
    (( told )) || { print -u2 "제어 대상 큐: 이 소유자의 끝난 사슬이 쥔 차례가 아직 남아 있다(그 사슬의 뒷정리가 VM 을 끄고 되돌리는 중일 수 있다). 뒷정리가 놓으면 바로, 놓지 않으면 그 차례가 마지막 활동에서 ${VMQ_LEASE}초 뒤 만료된 다음 이 명령이 새로 등록한다(그 차례에 적힌 프로세스가 살아 있으면 마지막 제어 명령 · 갱신에서 ${VMQ_HOLD_MAX}초까지는 만료되지 않는다)"; told=1 }
    (( deadline > 0 && EPOCHSECONDS >= deadline )) && return 75
    sleep 2
  done
}

# 차례를 잡을 때까지 기다린다: hold <소유자> <기한(epoch 초, 0 이면 기한 없음)>. 잡으면 REPLY 에 받은 VM.
# 기한이 이미 지났어도 차례표를 한 번 확인한 뒤 75 를 돌려준다(그 확인에서 잡았으면 0).
hold() {
  local owner=$1 deadline=$2 got=0 lost=0 start=$EPOCHSECONDS told=0 k
  while true; do
    # 기한 없이 기다리는 run 은 한 번 어디서 기다리는지 알린다(acquire 는 기한이 지나면 알린다)
    if (( deadline == 0 && ! told && EPOCHSECONDS > start )); then waiting_line $owner >&2; told=1; fi
    vmq_lock || return 1
    {
      vmq_sync $owner
      k=$REPLY
      if [[ -z $k ]]; then lost=1
      elif [[ -n ${Q_held[$k]} ]]; then got=1; REPLY=${Q_held[$k]}
      fi
    } always { vmq_unlock }
    (( lost )) && { print -u2 "제어 대상 큐: 차례가 사라졌다(만료 또는 강제로 놓음). 다시 acquire 한다"; return 1 }
    (( got )) && return 0
    (( deadline > 0 && EPOCHSECONDS >= deadline )) && return 75
    sleep 2
  done
}

waiting_line() {
  local owner=$1 k vm g
  vmq_lock || return 1
  { vmq_scan; vmq_plan } always { vmq_unlock }
  k=$(vmq_key $owner)
  [[ -n $k ]] || return 0
  print "기다리는 중: 요청 ${Q_need[$k]}"
  vmq_all_members ${=Q_need[$k]}
  for vm in $reply; do print "  $vm: $(vmq_holder_line $vm)$( [[ ${Q_busy[$vm]:-} == "~"* ]] && print ", 오래 기다린 차례 ${${Q_busy[$vm]#\~}#*-} 가 맡아 둠")"; done
  print "acquire 는 같은 명령을 다시 실행해 이어서 기다린다. 잡은 쪽의 차례는 마지막 활동에서 ${VMQ_LEASE}초가 지나면 지워진다(그 차례를 쥔 프로세스가 살아 있으면 마지막 제어 명령 · 갱신에서 ${VMQ_HOLD_MAX}초까지는 지우지 않는다)"
}

case $cmd in
peek-check)
  # 차례 없이 실행해도 되는 읽기인지 판별만 한다(lib/peek.zsh)
  source "${0:A:h:h}/lib/peek.zsh"
  peek_allowed "$*" && print "읽기: 차례 없이 실행해도 된다"
  ;;
list)
  # 대상 목록(VMQ_REGISTRY)
  for v in ${(ok)VMQ_HOST}; do print -r -- "$v	${VMQ_HOST[$v]}	${VMQ_ROLES[$v]// /,}"; done
  ;;
acquire)
  parse "$@"
  (( ${#reply} )) || usage
  expand_groups $reply || exit 1
  owner=$(vmq_owner) || exit 1
  # -w 는 이 명령 전체의 기한이다. register_wait 와 hold 가 같은 기한을 쓴다
  deadline=0; (( wait_s > 0 )) && deadline=$(( EPOCHSECONDS + wait_s ))
  register_wait $owner $deadline $groups; rc=$?
  (( rc == 1 )) && exit 1
  (( rc == 75 )) && exit 75
  hold $owner $deadline; rc=$?
  case $rc in
  0) print "잡음: ${REPLY// /, } (소유자 $owner). 끝나면 vmq release" ;;
  75) waiting_line $owner; exit 75 ;;
  *) exit 1 ;;
  esac
  ;;
mine)
  owner=$(vmq_owner) || exit 1
  held= ticket_ok=0
  vmq_lock || exit 1
  { vmq_sync $owner && { ticket_ok=1; k=$REPLY; held=${Q_held[$k]:-} } } always { vmq_unlock }
  # VM_QUEUE_TICKET 거절이면 vmq_ticket_ok 가 이유를 stderr 에 썼다
  (( ticket_ok )) || exit 1
  [[ -n $held ]] || { print -u2 "잡은 VM 이 없다(소유자 $owner)"; exit 1 }
  print -r -- $held
  ;;
ticket)
  # 이 소유자의 차례 키를 찍는다. 조회라 차례표를 정리만 하고(vmq_settle) 이 소유자의 차례라는 이유로 시각을 새로 적지는 않는다(vmq_touch 를
  # 부르지 않는다). vmq_settle 안의 vmq_purge(holdMax 로 판정한 차례의 시각을 새로 적음) · vmq_commit(배정된 대기 차례를 잡음)은 이 명령에서도
  # 돈다. 그 키를 VM_QUEUE_TICKET 에 주면 그 뒤의 vmq_require · vmq release 등은 그 차례에만 적용된다(lib/vmq.zsh 의 vmq_ticket_ok)
  owner=$(vmq_owner) || exit 1
  vmq_lock || exit 1
  { vmq_settle $owner; k=$REPLY } always { vmq_unlock }
  [[ -n $k ]] || { print -u2 "차례가 없다(소유자 $owner)"; exit 1 }
  print -r -- $k
  ;;
release)
  owner=$(vmq_owner) || exit 1
  vms=("$@"); (( ${#vms} )) || vms=(${(k)VMQ_HOST})
  gone=() ticket_ok=1
  vmq_lock || exit 1
  {
    vmq_scan
    k=$(vmq_key $owner)
    # VM_QUEUE_TICKET 이 지금 차례와 다르면 아무 파일도 지우지 않는다(이유는 vmq_ticket_ok 가 stderr 에 쓴다)
    if ! vmq_ticket_ok $owner "$k"; then
      ticket_ok=0
    elif [[ -n $k ]]; then
      left=()
      for vm in ${=Q_vms[$k]}; do
        if (( ${vms[(Ie)$vm]} )); then rm -f -- "$VMQ_DIR/$vm/$k"; gone+=($vm); else left+=($vm); fi
      done
      # 일부만 놓으면 남은 VM 으로 held · need 를 줄인다(놓은 VM 을 다시 기다리지 않게)
      if (( ${#left} && ${#gone} )) && [[ -n ${Q_held[$k]} ]]; then
        f="$VMQ_DIR/${left[1]}/$k"
        for vm in $left; do vmq_write "$VMQ_DIR/$vm/$k" $owner "$(vmq_field $f label)" "$(vmq_field $f created)" "$left" "$left" "$(vmq_field $f active)" "$(vmq_field $f procs)" "$(vmq_field $f chain)"; done
      fi
    fi
    (( ${#gone} )) && vmq_log "놓음 $owner ${(j: :)gone}"
  } always { vmq_unlock }
  (( ticket_ok )) || exit 1
  (( ${#gone} )) && print "놓음: ${(j:, :)gone}" || print "놓을 차례가 없다(소유자 $owner)"
  ;;
status)
  as_json=0; [[ ${1:-} == --json ]] && { as_json=1; shift }
  vms=("$@"); (( ${#vms} )) || vms=(${(ok)VMQ_HOST})
  me=$(vmq_owner 2>/dev/null || print -)
  vmq_lock || exit 1
  { vmq_purge; vmq_scan; vmq_plan } always { vmq_unlock }
  (( as_json )) && { status_json; exit 0 }
  for vm in $vms; do
    host=${VMQ_HOST[$vm]:-?}
    vmq_tickets $vm
    hk=$(vmq_holder $vm)
    if [[ -z $hk ]]; then
      line="$vm ($host): 비어 있음"
      [[ ${Q_busy[$vm]:-} == "~"* ]] && line+=", 오래 기다린 차례 ${${Q_busy[$vm]#\~}#*-} 가 맡아 둠"
      [[ -n ${Q_busy[$vm]:-} && ${Q_busy[$vm]} != "~"* ]] && line+=", ${Q_busy[$vm]#*-} 에게 배정됨(그 소유자가 다음에 확인할 때 잡는다)"
      print -r -- $line
    else
      # held 에 적힌 대상의 파일이 없으면(대상마다 만료를 판정하던 전의 vmq_purge 가 남긴 차례) 그 차례의 남은 파일로 읽는다
      f="$VMQ_DIR/$vm/$hk"; [[ -f $f ]] || f=${Q_file[$hk]}
      o=$(vmq_key_owner $hk); l=$(vmq_field $f label); c=$(vmq_field $f created)
      mark=""; [[ $o == $me ]] && mark=" ← 이 세션"
      # 만료는 차례 단위로 판정한다(vmq_purge 와 같은 vmq_key_expiry). 같은 차례의 대상 줄은 모두 같은 만료를 찍는다
      vmq_key_expiry $hk ${=Q_vms[$hk]}
      if [[ ${Q_exp[1]} == holdMax ]]; then
        lease_line="프로세스 ${Q_exp[3]} 가 살아 있어 만료되지 않음(마지막 제어 명령 · 갱신 ${Q_exp[4]}초 전, 상한 ${VMQ_HOLD_MAX}초)"
      else
        lease_line="마지막 활동 ${Q_exp[4]}초 전, 만료까지 ${Q_exp[2]}초"
      fi
      print "$vm ($host): 잡음 $o${l:+ ($l)}, 함께 잡은 VM ${Q_held[$hk]}, 등록 $(( EPOCHSECONDS - c ))초 전, $lease_line$mark"
    fi
    i=1
    for f in $reply; do
      k=${f:t}
      [[ $k == $hk ]] && continue
      o=$(vmq_key_owner $k); l=$(vmq_field $f label); c=$(vmq_field $f created)
      mark=""; [[ $o == $me ]] && mark=" ← 이 세션"
      print "  대기 $i: $o${l:+ ($l)}, 요청 ${Q_need[$k]}, 등록 $(( EPOCHSECONDS - c ))초 전$mark"
      (( i++ ))
    done
  done
  ;;
run)
  parse "$@"; specs=() cmdline=()
  # `--` 앞은 묶음, 뒤는 명령
  seen=0
  for a in $reply; do
    if (( ! seen )) && [[ $a == -- ]]; then seen=1; continue; fi
    (( seen )) && cmdline+=("$a") || specs+=("$a")
  done
  (( ${#specs} && ${#cmdline} )) || usage
  expand_groups $specs || exit 1
  owner=$(vmq_owner) || exit 1
  register_wait $owner 0 $groups; rc=$?
  (( rc == 1 )) && exit 1
  mine=$(( rc == 0 ))
  # TERM · INT · HUP 으로 끝나도 이 명령이 만든 차례(기다리는 요청이든 잡은 차례든)를 놓는다. 전에는 명령이 돌아온 뒤에만 놓아,
  # TaskStop(프로세스 그룹에 TERM) · pkill 로 끝난 run 의 SMB 빌드 차례가 LEASE 1200초 동안 남았다(2026-10-23 두 번, bug_1792813277239_fyx5wg).
  # zsh 는 명령(자식)이 도는 동안 받은 신호의 trap 을 그 명령이 끝난 뒤 실행하므로, run 에만 TERM 이 가면 명령이 끝날 때까지 차례를 쥔다.
  # KILL 은 받을 수 없고 그때 명령이 아직 도는지도 알 수 없어 전처럼 LEASE 로 만료된다.
  granted=
  run_release() { (( mine )) && "$self" release ${=granted} >/dev/null 2>&1; true }
  trap 'run_release; exit 129' HUP
  trap 'run_release; exit 130' INT
  trap 'run_release; exit 143' TERM
  hold $owner 0 || { run_release; exit 1 }
  granted=$REPLY
  # 명령이 도는 동안 이 프로세스가 차례를 쥔다(명령이 vmq_require 를 부르지 않아도 만료되지 않게)
  vmq_lock || exit 1
  { vmq_sync $owner; vmq_attach $REPLY $$ } always { vmq_unlock }
  VM_QUEUE_GRANTED=$granted "${cmdline[@]}"; rc=$?
  run_release
  exit $rc
  ;;
ended)
  # 이 소유자의 그 VM 차례가 마지막에 어떻게 끝났는지를 차례표의 log 에서 읽는다(기록 형식은 이 파일 · lib/vmq.zsh 의 vmq_log 줄이 정한다).
  # 사건 · 시각 · 그 뒤 그 VM 을 잡은 다른 소유자(없으면 -)를 한 줄로 찍는다: `만료 2026-10-23 07:13:08 -`. 그 뒤 이 소유자가 다시 잡았거나
  # 끝난 차례가 없으면 종료 코드 1. poieve 의 vm_chain_watch 가 사슬이 놓은 것과 만료로 지워진 것을 가를 때 부른다(bug_1792774871149_2f64d4).
  vm=${1:?대상}; [[ -n ${VMQ_HOST[$vm]:-} ]] || { print -u2 "모르는 대상: $vm"; exit 1 }
  owner=$(vmq_owner) || exit 1
  [[ -r $VMQ_DIR/log ]] || { print -u2 "차례표의 log 가 없다: $VMQ_DIR/log"; exit 1 }
  awk -v vm=$vm -v me=$owner '
    # 잡음 <소유자> <VM>…[ (설명)] · 놓음 <소유자> <VM>… · 만료 <VM> <소유자> (…) · 강제로 놓음 <VM>… <소유자> (요청 …)
    function has(from, to,   i) { for (i = from; i <= to; i++) if ($i == vm) return 1; return 0 }
    function finish(e) { ev = e; at = $1 " " $2; next_owner = "-"; ended = 1 }
    $3 == "잡음" {
      last = NF; for (i = 5; i <= NF; i++) if (substr($i, 1, 1) == "(") { last = i - 1; break }
      if (!has(5, last)) next
      if ($4 == me) ended = 0; else if (ended && next_owner == "-") next_owner = $4
      next
    }
    $3 == "놓음" && $4 == me && has(5, NF) { finish("놓음"); next }
    $3 == "만료" && $4 == vm && $5 == me { finish("만료"); next }
    $3 == "강제로" && $4 == "놓음" {
      for (i = 5; i <= NF; i++) if (substr($i, 1, 3) == "(요청") break
      if ($(i - 1) == me && has(5, i - 2)) finish("강제로놓음")
    }
    END { if (!ended) exit 1; print ev, at, next_owner }
  ' "$VMQ_DIR/log" || { print -u2 "$vm 에서 끝난 차례가 없다(소유자 $owner, 기록 $VMQ_DIR/log)"; exit 1 }
  ;;
force-release)
  vm=${1:?대상}; [[ -n ${VMQ_HOST[$vm]:-} ]] || { print -u2 "모르는 대상: $vm"; exit 1 }
  vmq_lock || exit 1
  {
    vmq_scan
    hk=$(vmq_holder $vm)
    if [[ -n $hk ]]; then
      for v in ${=Q_vms[$hk]}; do rm -f -- "$VMQ_DIR/$v/$hk"; done
      vmq_log "강제로 놓음 ${Q_vms[$hk]} $(vmq_key_owner $hk) (요청 $(vmq_owner 2>/dev/null || print -))"
      print "강제로 놓음: ${Q_vms[$hk]} 의 $(vmq_key_owner $hk)"
    else
      print "$vm: 잡은 차례가 없다"
    fi
  } always { vmq_unlock }
  ;;
*) usage ;;
esac
