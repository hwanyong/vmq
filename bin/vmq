#!/bin/zsh
# vmq: the control queue for targets several sessions share (README.md; rules, turn files and assignment are in lib/vmq.zsh).
# Take a turn before driving a target and release it when done. A project's tool that drives the target refuses without a turn.
# Usage:
#   vmq acquire [-w seconds] [-l label] <group>…  Takes a turn: one candidate per group. A group is a target name,
#                                                comma-separated candidates (Server1,Server2) or a role (@server).
#                                                The candidate free first is taken. A candidate can be targets joined with
#                                                + (Server2+Client2), taken when all are free. @server+@client is a server
#                                                and a client on the same Mac. Waits while another owner holds it (default
#                                                90 s). On success exits 0 and prints the targets in group order. On timeout
#                                                exits 75 and the request stays (run the same command again to keep
#                                                waiting). -w is the deadline of the whole command (waiting for an ended
#                                                chain's turn to go plus waiting to take; 0 waits forever). Running again
#                                                with other groups while waiting changes the request under the same number
#   vmq mine                                     Prints the targets I hold, in group order, on one line. Exit 1 when none
#   vmq ticket                                   Prints my turn key (<10-digit sequence>-<owner>, held or waiting). Exit 1
#                                                when none
#   vmq release [<target>…]                      Removes my turn. With targets, releases only those
#   vmq status [<target>…]                       The holder and the waiting owners of each target
#   vmq status --json [<target>…]                The same judgement as one JSON value per request (turn). Format: README.md
#                                                "status --json"
#   vmq ended <target>                           How my last turn on that target ended (released, expired, force-released),
#                                                when, and the other owner that took it afterwards (- for none)
#   vmq run [-l label] <group>… -- <command…>     Waits until the turn is taken, runs the command, then releases the turn
#                                                if this command took it. Also releases on TERM, INT and HUP (after the
#                                                command ends, when it was running). After KILL the turn expires by LEASE.
#                                                The command gets the targets in VM_QUEUE_GRANTED (space-separated)
#   vmq force-release <target>                   Removes the turn that holds that target. Only when the user says so
#   vmq list                                     The target list (name, Mac, roles, operating system)
#   vmq paths [--json]                           The data folder, target list, queue and cache folder in use (lib/paths.zsh);
#                                                --json gives the host's native paths (Windows paths on Windows)
#   vmq init                                     Creates the data folder and an empty target list ($VMQ_REGISTRY) when absent
#   vmq target add <name> <mac> <roles> <os>     Adds a target to the target list. <mac> is the SSH address of the Mac the
#                                                target is on (any name for this Mac, such as localhost; targets with the same
#                                                value are on the same Mac). <roles> is comma-separated (- for none). <os> is
#                                                macOS, Windows, Linux or - (none, such as a build slot)
#   vmq target remove <name>                     Removes a target no turn holds or waits for
#   vmq peek-check '<one command line>'          Whether a read may run without a turn (exit 0 or 1)
# Owner: VM_QUEUE_OWNER, else CLAUDE_CODE_SESSION_ID, else in a Doghoodie tab the id of the session that opened it
# (vmq_owner_doghoodie in lib/vmq.zsh). Label: -l or VM_QUEUE_LABEL.
# Pinning a turn: with VM_QUEUE_TICKET=<key> (as vmq ticket printed it), mine and release (and vmq_require, vmq_keepalive,
# vmq_chain_of and vmq_chain_mark in lib/vmq.zsh) act only when that key is my current turn; otherwise they do nothing, write the
# pinned and current keys to stderr and exit 1. Other commands ignore it (run removes it before running the command).
# Exit codes: 0 success, 1 refused or error, 2 usage, 75 waiting.
set -uo pipefail
cmd=${1:-status}; (( $# )) && shift
# init and target work before a target list exists
[[ $cmd == (init|target|paths) ]] && VMQ_REGISTRY_OPTIONAL=1
source "${0:A:h:h}/lib/vmq.zsh"

# This script's path. Inside a function $0 is the function name (zsh FUNCTION_ARGZERO), so it is taken here
self=${0:A}
# The usage is this file's head comment (from the second line to before the first line not starting with #)
usage() { sed -n '2,/^[^#]/{/^#/p;}' "$self"; exit 2 }

# Only mine and release read VM_QUEUE_TICKET (vmq_sync and vmq_ticket_ok in lib/vmq.zsh). Other commands unset it: so the
# vmq_sync called by register and hold in acquire and run does not refuse on it, so run's own release (run_release, vmq release)
# is not refused by an inherited value and the command does not inherit it, and so ticket reads the key afresh.
[[ $cmd == (mine|release) ]] || unset VM_QUEUE_TICKET

# Options: -w seconds and -l label. The rest stays in reply.
wait_s=90 label=${VM_QUEUE_LABEL:-}
parse() {
  reply=()
  while (( $# )); do
    case $1 in
    -w) wait_s=${2:?seconds}; shift 2 ;;
    -l) label=${2:?label}; shift 2 ;;
    --) reply+=("$@"); return ;;
    *) reply+=("$1"); shift ;;
    esac
  done
}

# Expands the groups into groups: expand_groups <group>…
expand_groups() {
  local g e
  groups=()
  for g in "$@"; do e=$(vmq_expand $g) || return 1; groups+=($e); done
}

# One JSON string: json_str <value> → REPLY. Escapes backslash, quote, newline, tab and CR, and removes other control characters
json_str() {
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\t'/\\t}; s=${s//$'\r'/\\r}; s=${s//[[:cntrl:]]/}
  REPLY="\"$s\""
}
# A JSON string array: json_arr <value>… → REPLY
json_arr() { local x out=(); for x in "$@"; do json_str "$x"; out+=($REPLY); done; REPLY="[${(j:,:)out}]" }
# null for an empty value: json_opt <value> → REPLY
json_opt() { [[ -n $1 ]] && json_str "$1" || REPLY=null }

# The body of vmq status --json (after vmq_purge, vmq_scan and vmq_plan under the lock). Targets are $vms, this session's owner
# is $me. One value per target and one per turn (request). Only turns with a file on a target in $vms are included. Expiry is
# judged per turn by vmq_key_expiry in lib/vmq.zsh.
status_json() {
  local vm k f hk busy o waiting tv targets=() requests=() fields
  for vm in $vms; do
    hk=$(vmq_holder $vm); busy=${Q_busy[$vm]:-}
    vmq_tickets $vm; waiting=()
    for f in $reply; do [[ ${f:t} == $hk ]] || waiting+=(${f:t}); done
    fields=()
    json_str "$vm"; fields+=("\"name\":$REPLY")
    json_str "${VMQ_HOST[$vm]:-}"; fields+=("\"host\":$REPLY")
    json_arr ${=VMQ_ROLES[$vm]:-}; fields+=("\"roles\":$REPLY")
    json_opt "${VMQ_OS[$vm]:#-}"; fields+=("\"os\":$REPLY")
    json_opt "$hk"; fields+=("\"holder\":$REPLY")
    # assigned: the waiting turn that takes the target at its next check. reserved: the turn past VMQ_STARVE that reserves it (vmq_plan's "~")
    [[ -n $busy && $busy != "~"* && $busy != $hk ]] && json_str "$busy" || REPLY=null; fields+=("\"assigned\":$REPLY")
    [[ $busy == "~"* ]] && json_str "${busy#\~}" || REPLY=null; fields+=("\"reserved\":$REPLY")
    json_arr $waiting; fields+=("\"waiting\":$REPLY")
    targets+=("{${(j:,:)fields}}")
  done
  for k in ${(ok)Q_vms}; do
    tv=(${=Q_vms[$k]}); tv=(${tv:*vms}); (( ${#tv} )) || continue
    f=${Q_file[$k]}; o=$(vmq_key_owner $k); vmq_key_expiry $k ${=Q_vms[$k]}
    fields=()
    json_str "$k"; fields+=("\"key\":$REPLY" "\"seq\":$(( 10#${k%%-*} ))")
    json_str "$o"; fields+=("\"owner\":$REPLY")
    [[ $o == $me ]] && fields+=("\"isMine\":true") || fields+=("\"isMine\":false")
    json_str "$(vmq_field $f label)"; fields+=("\"label\":$REPLY")
    json_arr ${=Q_need[$k]}; fields+=("\"need\":$REPLY")
    json_arr ${=Q_vms[$k]}; fields+=("\"targets\":$REPLY")
    json_arr ${=Q_held[$k]}; fields+=("\"held\":$REPLY")
    [[ -z ${Q_held[$k]} ]] && json_arr ${=Q_alloc[$k]:-} || json_arr; fields+=("\"assigned\":$REPLY")
    fields+=("\"created\":$(( $(vmq_field $f created) + 0 ))" "\"active\":$(( $(vmq_field $f active) + 0 ))")
    json_arr ${=$(vmq_field $f procs)}; fields+=("\"procs\":$REPLY")
    json_arr ${=Q_exp[3]}; fields+=("\"alive\":$REPLY")
    fields+=("\"expiry\":{\"basis\":\"${Q_exp[1]}\",\"seconds\":${Q_exp[2]},\"since\":${Q_exp[4]}}")
    requests+=("{${(j:,:)fields}}")
  done
  json_opt "${me:#-}"
  print -r -- "{\"version\":1,\"now\":$EPOCHSECONDS,\"lease\":$VMQ_LEASE,\"holdMax\":$VMQ_HOLD_MAX,\"starve\":$VMQ_STARVE,\"owner\":$REPLY,\"targets\":[${(j:,:)targets}],\"requests\":[${(j:,:)requests}]}"
}

# Can the held targets fill the groups: covers <held targets> <group>…. Every target of a candidate (joined with +) must be held.
covers() {
  local held=$1 g c vm used=() hit ok; shift
  for g in "$@"; do
    hit=
    for c in ${(s:,:)g}; do
      ok=1
      for vm in ${(s:+:)c}; do vmq_has "$held" $vm && (( ! ${used[(Ie)$vm]} )) || { ok=0; break }; done
      (( ok )) && { hit=$c; break }
    done
    [[ -n $hit ]] || return 1
    used+=(${(s:+:)hit})
  done
}

# Creates or changes a turn: register <owner> <group>… → 0 when created, 3 when it already existed, 1 when refused.
# A held turn is not changed: taking more while holding can put targets in different orders and deadlock. While waiting it is
# changed under the same sequence number.
# When the held turn is one held by an ended chain (vmq_chain_ended in lib/vmq.zsh), 4: that chain's cleanup may still be
# stopping and restoring targets with it, so it is not handed even to the same owner. The caller (register_wait) waits until
# that turn is gone and then registers anew. On 4 the turn file's time (last activity) is not written; the vmq_sync this
# function calls makes that judgement with the same vmq_chain_ended. A turn the cleanup never releases is removed by vmq_purge
# VMQ_LEASE seconds after its last activity, and this function then registers under a new sequence number.
register() {
  local owner=$1 vm k f seq rc=3 c all=()
  shift
  local need="$*"
  vmq_all_members "$@"; all=($reply)
  vmq_lock || return 1
  {
    # acquire and run unset VM_QUEUE_TICKET, so vmq_sync does not refuse
    vmq_sync $owner
    k=$REPLY
    # The always block's vmq_unlock runs on this return too
    vmq_chain_ended "$k" && return 4
    if [[ -n $k && -n ${Q_held[$k]} ]]; then
      if ! covers "${Q_held[$k]}" "$@"; then
        print -u2 "vmq: this owner already holds ${Q_held[$k]}. To get $need, vmq release and acquire them together"
        rc=1
      fi
    elif [[ -n $k ]]; then
      if [[ ${Q_need[$k]} != $need ]]; then
        c=$(vmq_field ${Q_file[$k]} created)
        [[ -n $label ]] || label=$(vmq_field ${Q_file[$k]} label)
        for vm in ${(ok)VMQ_HOST}; do
          f="$VMQ_DIR/$vm/$k"
          if (( ${all[(Ie)$vm]} )); then mkdir -p "$VMQ_DIR/$vm"; vmq_write $f $owner "$label" $c "$need"; else rm -f -- $f; fi
        done
        vmq_log "changed $owner $need${label:+ ($label)} (sequence ${k%%-*} kept)"
      fi
    else
      seq=$(( $(cat "$VMQ_DIR/.seq" 2>/dev/null || print 0) + 1 ))
      print $seq > "$VMQ_DIR/.seq"
      for vm in $all; do
        mkdir -p "$VMQ_DIR/$vm"
        vmq_write "$VMQ_DIR/$vm/${(l:10::0:)seq}-$owner" $owner "$label" $EPOCHSECONDS "$need"
      done
      vmq_log "registered $owner $need${label:+ ($label)}"
      rc=0
    fi
  } always { vmq_unlock }
  return $rc
}

# While register returns 4 (a turn held by an ended chain is still there), calls register again every 2 seconds until it is gone:
# register_wait <owner> <deadline (epoch seconds, 0 for none)> <group>…
# acquire sets the deadline once at its start, and this function and hold share it, so acquire -w N waits at most about N seconds.
# That turn goes when the cleanup releases it (vmq release) or, if it never does, when it expires VMQ_LEASE seconds after its
# last activity. register does not write its time meanwhile. While a process written in its procs is alive and VMQ_HOLD_MAX has
# not passed since the last control command or refresh (active), the queue reader (vmq_purge) writes its time so it does not expire.
# Returns as register does, or 75 when the turn is not gone by the deadline.
register_wait() {
  local owner=$1 deadline=$2 rc told=0
  shift 2
  while true; do
    register $owner "$@"; rc=$?
    (( rc == 4 )) || return $rc
    (( told )) || { print -u2 "vmq: a turn of this owner held by an ended chain is still there (its cleanup may be stopping and restoring targets). This command registers anew as soon as the cleanup releases it, or else after it expires ${VMQ_LEASE} s after its last activity (not before ${VMQ_HOLD_MAX} s after its last control command or refresh while a process written in it is alive)"; told=1 }
    (( deadline > 0 && EPOCHSECONDS >= deadline )) && return 75
    sleep 2
  done
}

# Waits until the turn is taken: hold <owner> <deadline (epoch seconds, 0 for none)>. On success the targets are in REPLY.
# Even when the deadline has already passed, the queue is checked once before 75 is returned (0 if that check took it).
hold() {
  local owner=$1 deadline=$2 got=0 lost=0 start=$EPOCHSECONDS told=0 k
  while true; do
    # A run that waits with no deadline says once where it waits (acquire says so when the deadline passes)
    if (( deadline == 0 && ! told && EPOCHSECONDS > start )); then waiting_line $owner >&2; told=1; fi
    vmq_lock || return 1
    {
      vmq_sync $owner
      k=$REPLY
      if [[ -z $k ]]; then lost=1
      elif [[ -n ${Q_held[$k]} ]]; then got=1; REPLY=${Q_held[$k]}
      fi
    } always { vmq_unlock }
    (( lost )) && { print -u2 "vmq: the turn is gone (expired or force-released). Acquire again"; return 1 }
    (( got )) && return 0
    (( deadline > 0 && EPOCHSECONDS >= deadline )) && return 75
    sleep 2
  done
}

waiting_line() {
  local owner=$1 k vm g
  vmq_lock || return 1
  { vmq_scan; vmq_plan } always { vmq_unlock }
  k=$(vmq_key $owner)
  [[ -n $k ]] || return 0
  print "waiting: request ${Q_need[$k]}"
  vmq_all_members ${=Q_need[$k]}
  for vm in $reply; do print "  $vm: $(vmq_holder_line $vm)$( [[ ${Q_busy[$vm]:-} == "~"* ]] && print ", reserved by long-waiting turn ${${Q_busy[$vm]#\~}#*-}")"; done
  print "acquire keeps waiting when run again with the same command. The holder's turn is removed ${VMQ_LEASE} s after its last activity (not before ${VMQ_HOLD_MAX} s after its last control command or refresh while the process holding it is alive)"
}

case $cmd in
peek-check)
  # Only judges whether a read may run without a turn (lib/peek.zsh)
  source "${0:A:h:h}/lib/peek.zsh"
  peek_allowed "$*" && print "read: may run without a turn"
  ;;
paths)
  # For the mod and for people: where this host keeps vmq's files. jq builds the JSON so any path is quoted right.
  # --json is for programs outside this shell (the mod), so on Windows its paths are Windows paths (cygpath -w)
  if [[ ${1:-} == --json ]]; then
    native() { if [[ $OSTYPE == (cygwin|msys)* ]]; then cygpath -w -- "$1"; else print -r -- "$1"; fi }
    jq -n --arg data "$(native $VMQ_DATA)" --arg registry "$(native $VMQ_REGISTRY)" --arg queue "$(native $VMQ_DIR)" --arg hosts "$(native $VMQ_HOSTS_FILE)" --arg cache "$(native $VMQ_CACHE)" \
      '{data: $data, registry: $registry, queue: $queue, hosts: $hosts, cache: $cache}'
  else
    print -l -- "data	$VMQ_DATA" "registry	$VMQ_REGISTRY" "queue	$VMQ_DIR" "hosts	$VMQ_HOSTS_FILE" "cache	$VMQ_CACHE"
  fi
  ;;
list)
  # The target list (VMQ_REGISTRY)
  for v in ${(ok)VMQ_HOST}; do print -r -- "$v	${VMQ_HOST[$v]}	${VMQ_ROLES[$v]// /,}	${VMQ_OS[$v]}"; done
  ;;
acquire)
  parse "$@"
  (( ${#reply} )) || usage
  expand_groups $reply || exit 1
  owner=$(vmq_owner) || exit 1
  # -w is the deadline of the whole command. register_wait and hold share it
  deadline=0; (( wait_s > 0 )) && deadline=$(( EPOCHSECONDS + wait_s ))
  register_wait $owner $deadline $groups; rc=$?
  (( rc == 1 )) && exit 1
  (( rc == 75 )) && exit 75
  hold $owner $deadline; rc=$?
  case $rc in
  0) print "held: ${REPLY// /, } (owner $owner). vmq release when done" ;;
  75) waiting_line $owner; exit 75 ;;
  *) exit 1 ;;
  esac
  ;;
mine)
  owner=$(vmq_owner) || exit 1
  held= ticket_ok=0
  vmq_lock || exit 1
  { vmq_sync $owner && { ticket_ok=1; k=$REPLY; held=${Q_held[$k]:-} } } always { vmq_unlock }
  # On a VM_QUEUE_TICKET refusal vmq_ticket_ok wrote the reason to stderr
  (( ticket_ok )) || exit 1
  [[ -n $held ]] || { print -u2 "vmq: no target held (owner $owner)"; exit 1 }
  print -r -- $held
  ;;
ticket)
  # Prints this owner's turn key. It is a read, so the queue is only settled (vmq_settle) and the time is not written because it
  # is this owner's turn (vmq_touch is not called). vmq_purge (writes the time of turns judged holdMax) and vmq_commit (takes an
  # assigned waiting turn) inside vmq_settle run here too. With that key in VM_QUEUE_TICKET, later vmq_require, vmq release and
  # the rest apply only to that turn (vmq_ticket_ok in lib/vmq.zsh)
  owner=$(vmq_owner) || exit 1
  vmq_lock || exit 1
  { vmq_settle $owner; k=$REPLY } always { vmq_unlock }
  [[ -n $k ]] || { print -u2 "vmq: no turn (owner $owner)"; exit 1 }
  print -r -- $k
  ;;
release)
  owner=$(vmq_owner) || exit 1
  vms=("$@"); (( ${#vms} )) || vms=(${(k)VMQ_HOST})
  gone=() ticket_ok=1
  vmq_lock || exit 1
  {
    vmq_scan
    k=$(vmq_key $owner)
    # When VM_QUEUE_TICKET differs from the current turn no file is removed (vmq_ticket_ok writes the reason to stderr)
    if ! vmq_ticket_ok $owner "$k"; then
      ticket_ok=0
    elif [[ -n $k ]]; then
      left=()
      for vm in ${=Q_vms[$k]}; do
        if (( ${vms[(Ie)$vm]} )); then rm -f -- "$VMQ_DIR/$vm/$k"; gone+=($vm); else left+=($vm); fi
      done
      # A partial release narrows held and need to the targets left (so the released ones are not waited for again)
      if (( ${#left} && ${#gone} )) && [[ -n ${Q_held[$k]} ]]; then
        f="$VMQ_DIR/${left[1]}/$k"
        for vm in $left; do vmq_write "$VMQ_DIR/$vm/$k" $owner "$(vmq_field $f label)" "$(vmq_field $f created)" "$left" "$left" "$(vmq_field $f active)" "$(vmq_field $f procs)" "$(vmq_field $f chain)"; done
      fi
    fi
    (( ${#gone} )) && vmq_log "released $owner ${(j: :)gone}"
  } always { vmq_unlock }
  (( ticket_ok )) || exit 1
  (( ${#gone} )) && print "released: ${(j:, :)gone}" || print "nothing to release (owner $owner)"
  ;;
status)
  as_json=0; [[ ${1:-} == --json ]] && { as_json=1; shift }
  vms=("$@"); (( ${#vms} )) || vms=(${(ok)VMQ_HOST})
  me=$(vmq_owner 2>/dev/null || print -)
  vmq_lock || exit 1
  { vmq_purge; vmq_scan; vmq_plan } always { vmq_unlock }
  (( as_json )) && { status_json; exit 0 }
  for vm in $vms; do
    host=${VMQ_HOST[$vm]:-?}
    vmq_tickets $vm
    hk=$(vmq_holder $vm)
    if [[ -z $hk ]]; then
      line="$vm ($host): free"
      [[ ${Q_busy[$vm]:-} == "~"* ]] && line+=", reserved by long-waiting turn ${${Q_busy[$vm]#\~}#*-}"
      [[ -n ${Q_busy[$vm]:-} && ${Q_busy[$vm]} != "~"* ]] && line+=", assigned to ${Q_busy[$vm]#*-} (that owner takes it at its next check)"
      print -r -- $line
    else
      # When the file of a target in held is gone (a turn left by an older per-file vmq_purge), read the turn's remaining file
      f="$VMQ_DIR/$vm/$hk"; [[ -f $f ]] || f=${Q_file[$hk]}
      o=$(vmq_key_owner $hk); l=$(vmq_field $f label); c=$(vmq_field $f created)
      mark=""; [[ $o == $me ]] && mark=" ← this session"
      # Expiry is judged per turn (the same vmq_key_expiry as vmq_purge), so every target line of a turn shows the same expiry
      vmq_key_expiry $hk ${=Q_vms[$hk]}
      if [[ ${Q_exp[1]} == holdMax ]]; then
        lease_line="does not expire while process ${Q_exp[3]} is alive (last control command or refresh ${Q_exp[4]} s ago, limit ${VMQ_HOLD_MAX} s)"
      else
        lease_line="last activity ${Q_exp[4]} s ago, expires in ${Q_exp[2]} s"
      fi
      print "$vm ($host): held by $o${l:+ ($l)}, held together ${Q_held[$hk]}, registered $(( EPOCHSECONDS - c )) s ago, $lease_line$mark"
    fi
    i=1
    for f in $reply; do
      k=${f:t}
      [[ $k == $hk ]] && continue
      o=$(vmq_key_owner $k); l=$(vmq_field $f label); c=$(vmq_field $f created)
      mark=""; [[ $o == $me ]] && mark=" ← this session"
      print "  waiting $i: $o${l:+ ($l)}, request ${Q_need[$k]}, registered $(( EPOCHSECONDS - c )) s ago$mark"
      (( i++ ))
    done
  done
  ;;
run)
  parse "$@"; specs=() cmdline=()
  # Groups before `--`, the command after
  seen=0
  for a in $reply; do
    if (( ! seen )) && [[ $a == -- ]]; then seen=1; continue; fi
    (( seen )) && cmdline+=("$a") || specs+=("$a")
  done
  (( ${#specs} && ${#cmdline} )) || usage
  expand_groups $specs || exit 1
  owner=$(vmq_owner) || exit 1
  register_wait $owner 0 $groups; rc=$?
  (( rc == 1 )) && exit 1
  mine=$(( rc == 0 ))
  # Releases the turn this command made (a waiting request or a held turn) also when ended by TERM, INT or HUP. Otherwise a
  # run ended by a tool stop (TERM to the process group) or pkill would leave its turn until the lease ran out.
  # zsh runs the trap of a signal received while a command (child) runs after that command ends, so when only run gets TERM,
  # the turn is held until the command ends. KILL cannot be caught, and whether the command still runs then is unknown, so the
  # turn expires by LEASE.
  granted=
  run_release() { (( mine )) && "$self" release ${=granted} >/dev/null 2>&1; true }
  trap 'run_release; exit 129' HUP
  trap 'run_release; exit 130' INT
  trap 'run_release; exit 143' TERM
  hold $owner 0 || { run_release; exit 1 }
  granted=$REPLY
  # This process holds the turn while the command runs (so it does not expire even if the command never calls vmq_require).
  # Without the lock the turn is released before exiting: it is held now, and nothing else would release it before its lease
  # ran out (seen in tests/pair.zsh on CI runners)
  vmq_lock || { run_release; exit 1 }
  { vmq_sync $owner; vmq_attach $REPLY $$ } always { vmq_unlock }
  VM_QUEUE_GRANTED=$granted "${cmdline[@]}"; rc=$?
  run_release
  exit $rc
  ;;
ended)
  # Reads from the queue log how this owner's last turn on the target ended (the record forms are set by the vmq_log lines in
  # this file and lib/vmq.zsh). Prints one line: event, time, and the other owner that took the target afterwards (- for none):
  # `expired 2026-10-23 07:13:08 -`. Exit 1 when this owner took it again afterwards or no ended turn is found. A chain
  # watcher calls this to tell a turn its chain released from one removed by expiry.
  vm=${1:?target}; [[ -n ${VMQ_HOST[$vm]:-} ]] || { print -u2 "vmq: unknown target: $vm"; exit 1 }
  owner=$(vmq_owner) || exit 1
  [[ -r $VMQ_DIR/log ]] || { print -u2 "vmq: no queue log: $VMQ_DIR/log"; exit 1 }
  awk -v vm=$vm -v me=$owner '
    # held <owner> <target>…[ (label)] · released <owner> <target>… · expired <target> <owner> (…) · force-released <target>… <owner> (by …)
    function has(from, to,   i) { for (i = from; i <= to; i++) if ($i == vm) return 1; return 0 }
    function finish(e) { ev = e; at = $1 " " $2; next_owner = "-"; ended = 1 }
    $3 == "held" {
      last = NF; for (i = 5; i <= NF; i++) if (substr($i, 1, 1) == "(") { last = i - 1; break }
      if (!has(5, last)) next
      if ($4 == me) ended = 0; else if (ended && next_owner == "-") next_owner = $4
      next
    }
    $3 == "released" && $4 == me && has(5, NF) { finish("released"); next }
    $3 == "expired" && $4 == vm && $5 == me { finish("expired"); next }
    $3 == "force-released" {
      for (i = 4; i <= NF; i++) if ($i == "(by") break
      if ($(i - 1) == me && has(4, i - 2)) finish("force-released")
    }
    END { if (!ended) exit 1; print ev, at, next_owner }
  ' "$VMQ_DIR/log" || { print -u2 "vmq: no ended turn on $vm (owner $owner, log $VMQ_DIR/log)"; exit 1 }
  ;;
force-release)
  vm=${1:?target}; [[ -n ${VMQ_HOST[$vm]:-} ]] || { print -u2 "vmq: unknown target: $vm"; exit 1 }
  vmq_lock || exit 1
  {
    vmq_scan
    hk=$(vmq_holder $vm)
    if [[ -n $hk ]]; then
      for v in ${=Q_vms[$hk]}; do rm -f -- "$VMQ_DIR/$v/$hk"; done
      vmq_log "force-released ${Q_vms[$hk]} $(vmq_key_owner $hk) (by $(vmq_owner 2>/dev/null || print -))"
      print "force-released: ${Q_vms[$hk]} of $(vmq_key_owner $hk)"
    else
      print "$vm: no turn holds it"
    fi
  } always { vmq_unlock }
  ;;
init)
  # Creates the data folder and a target list holding only its header comment. An existing list is left as it is
  if [[ -e $VMQ_REGISTRY ]]; then print "target list exists: $VMQ_REGISTRY ($(( ${#VMQ_HOST} )) targets)"; exit 0; fi
  mkdir -p "${VMQ_REGISTRY:h}" || exit 1
  sed -n '/^#/p' "$VMQ_ROOT/examples/resources.tsv" | sed '1s/.*/# vmq target list. Add targets with `vmq target add` (README "Targets")./' > "$VMQ_REGISTRY" || exit 1
  print "created: $VMQ_REGISTRY. Add targets: vmq target add <name> <mac> <roles> <os>"
  ;;
target)
  sub=${1:-}; (( $# )) && shift
  case $sub in
  add)
    (( $# == 4 )) || { print -u2 "usage: vmq target add <name> <mac> <roles, comma-separated or -> <os: macOS|Windows|Linux|->"; exit 2 }
    name=$1 mac=$2 roles=$3 os=$4
    # The name goes into turn file paths and the mac into ssh; roles and os are matched as words
    [[ $name =~ '^[A-Za-z0-9._-]+$' && $name != (.|..) ]] || { print -u2 "vmq: a target name takes only letters, digits and . _ -: $name"; exit 1 }
    [[ $mac =~ '^[A-Za-z0-9._:@-]+$' ]] || { print -u2 "vmq: the Mac address takes only letters, digits and . _ : @ -: $mac"; exit 1 }
    [[ $roles == - || $roles =~ '^[A-Za-z0-9_-]+(,[A-Za-z0-9_-]+)*$' ]] || { print -u2 "vmq: roles are words joined with , (or -): $roles"; exit 1 }
    [[ $os == (macOS|Windows|Linux|-) ]] || { print -u2 "vmq: the operating system is macOS, Windows, Linux or -: $os"; exit 1 }
    [[ $roles == - ]] && roles=
    [[ -e $VMQ_REGISTRY ]] || "$self" init >/dev/null || exit 1
    vmq_lock || exit 1
    {
      vmq_load_registry
      if [[ -n ${VMQ_HOST[$name]:-} ]]; then
        print -u2 "vmq: target $name exists (${VMQ_HOST[$name]}, roles ${${VMQ_ROLES[$name]// /,}:--}, ${VMQ_OS[$name]}). Remove it first to change it"; rc=1
      else
        print -r -- "$name	$mac	$roles	$os" >> "$VMQ_REGISTRY" && vmq_log "target-added $name $mac ${roles:--} $os" && rc=0 || rc=1
      fi
    } always { vmq_unlock }
    (( rc == 0 )) && print "added: $name	$mac	${roles:--}	$os"
    exit $rc
    ;;
  remove)
    (( $# == 1 )) || { print -u2 "usage: vmq target remove <name>"; exit 2 }
    name=$1
    vmq_lock || exit 1
    {
      vmq_load_registry
      if [[ -z ${VMQ_HOST[$name]:-} ]]; then
        print -u2 "vmq: no target $name in $VMQ_REGISTRY"; rc=1
      elif vmq_tickets $name; (( ${#reply} )); then
        print -u2 "vmq: turns hold or wait for $name (${(j:, :)${reply:t}}). Release them first (vmq status $name)"; rc=1
      else
        tmp=$VMQ_REGISTRY.$$
        awk -F '\t' -v n=$name '$1 != n' "$VMQ_REGISTRY" > $tmp && mv -- $tmp "$VMQ_REGISTRY" && rmdir "$VMQ_DIR/$name" 2>/dev/null
        vmq_log "target-removed $name"; rc=0
      fi
    } always { vmq_unlock }
    (( rc == 0 )) && print "removed: $name"
    exit $rc
    ;;
  *) usage ;;
  esac
  ;;
*) usage ;;
esac
