#!/bin/zsh
# The ssh given to scp with -S: sends ssh's own diagnostics to the VMQ_SSH_ERR file (vmq_ssh_retry in lib/vmq.zsh reads that file to
# tell a banner exchange timeout). scp has no -E of its own, so it goes through this file.
# -E and the path are passed as two arguments: zsh does not split ${X:+-E "$X"} into words, so it would become one argument
# "-E /path" and ssh would fail to open a path with a leading space
[[ -n ${VMQ_SSH_ERR:-} ]] && exec ssh -E "$VMQ_SSH_ERR" "$@"
exec ssh "$@"
